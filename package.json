{
  "name": "malzob",
  "version": "0.1.0",
  "description": "A minimal virtual tabletop (VTT) for D&D 5e: a Node server that syncs several browser clients in real time.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node build/server/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "preact": "10.29.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "typescript": "6.0.3"
  }
}
